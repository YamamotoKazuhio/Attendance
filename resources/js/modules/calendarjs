document.addEventListener("DOMContentLoaded", () => {
    // 休暇・残業申請ボタンのイベント設定
    const leaveBtn = document.getElementById("btnOpenLeaveModal");
    const leaveModal = document.getElementById("leaveModal");

    if (leaveBtn) {
        leaveBtn.addEventListener("click", () => {
            if (leaveModal) {
                leaveModal.style.display = "block";
            } else {
                console.error("ID: leaveModal が見つかりません。");
                alert("申請画面の準備ができていません。");
            }
        });
    }
    
    // 必要であればここで loadData() を実行
    // loadData(); 
});